/* =========================================================
   RUK THAI — LANDSCAPE CENTRING PASS
   Keep current scale, just centre the right-hand content block.
   ========================================================= */

@media (orientation: landscape) and (max-height: 430px) {

  .mobile-hero-logo {
    left: 68.5% !important;
    width: 40% !important;
    transform: translateX(-50%) !important;
  }

  .hero h1 {
    left: 68.5% !important;
    width: 42% !important;
    transform: translateX(-50%) !important;
    text-align: center !important;
  }

  .hero-actions {
    left: 68.5% !important;
    width: 40% !important;
    transform: translateX(-50%) !important;
  }

}

