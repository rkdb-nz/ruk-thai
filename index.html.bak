<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Ruk Thai | Thai Restaurant Greerton, Tauranga</title>
<meta name="description" content="Ruk Thai in Greerton, Tauranga. Call to order, view the menu, or get directions.">
<meta name="theme-color" content="#741d2b">
<link rel="stylesheet" href="styles.css">
<link rel="stylesheet" href="mobile-portrait.css">
<link rel="stylesheet" href="mobile-landscape.css">
<link rel="stylesheet" href="desktop-landing.css">
<link rel="stylesheet" href="desktop.css">
</head>
<body class="portrait-gateway">
<main id="main">
<section class="hero" aria-label="Ruk Thai landing page">
  <div class="hero-copy">
    <a class="mobile-hero-logo" href="index.html" aria-label="Ruk Thai home">
      <img src="assets/brand/ruk-thai-logo-banner.png" alt="Ruk Thai">
    </a>
    <h1>Thai food in Greerton, Tauranga</h1>
    <div class="hero-actions">
      <a class="btn btn-primary" href="tel:+6475796180" aria-label="Call Ruk Thai on 07 579 6180">
        <span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92z"/></svg></span>
        <span class="cta-title">CALL TO ORDER</span>
      </a>
      <a class="btn btn-outline" href="menu.html">
        <span class="cta-secondary-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3.5h6a2 2 0 0 1 2 2V21a2.5 2.5 0 0 0-2.5-2.5H4z"/><path d="M20 3.5h-6a2 2 0 0 0-2 2V21a2.5 2.5 0 0 1 2.5-2.5H20z"/><path d="M6.5 7h3M6.5 10h3M14.5 7h3M14.5 10h3"/></svg></span>
        <span>Menu</span>
      </a>
      <a class="text-link" href="directions.html" aria-label="Directions and location information for Ruk Thai">
        <span class="cta-secondary-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.4A2.4 2.4 0 1 1 12 6.6a2.4 2.4 0 0 1 0 4.8z"/></svg></span>
        <span>Directions</span>
      </a>
    </div>
  </div>
</section>
</main>
</body>
</html>
