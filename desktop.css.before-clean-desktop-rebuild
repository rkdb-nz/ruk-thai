    }

}

/* =========================================================
   DESKTOP TARGET TUNING 03 — EYEBROW + HEADLINE
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .desktop-eyebrow {
        top: 36.9% !important;
        left: 61.1% !important;
        width: 34% !important;
        font-size: clamp(.92rem, 1.02vw, 1.18rem) !important;
        letter-spacing: .34em !important;
    }

    .hero h1 {
        top: 41.0% !important;
        left: 61.1% !important;
        width: 40% !important;
        font-size: clamp(2.15rem, 2.5vw, 3.15rem) !important;
        line-height: 1 !important;
    }

}

/* =========================================================
   DESKTOP TARGET TUNING 04 — LOGO VERTICAL LOCK
   Clear the eyebrow exactly as in approved target.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .mobile-hero-logo {
        top: 4.2% !important;
        left: 61.1% !important;
        width: 53.7% !important;
    }

}

/* =========================================================
   DESKTOP TARGET TUNING 05 — LOGO FINAL RESPONSIVE LOCK
   Scale against BOTH viewport width and height so wide
   desktop screens preserve the approved target proportions.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .mobile-hero-logo {
        top: 8.5% !important;
        left: 61.1% !important;
        width: min(53.8vw, 93.3vh) !important;
        max-width: none !important;
    }

}

/* =========================================================
   DESKTOP TARGET TUNING 06 — LOGO TRUE FINAL LOCK
   Match visible approved target, accounting for transparent
   space inside the logo PNG.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .mobile-hero-logo {
        top: 4.2% !important;
        left: 61.1% !important;
        width: 53.7vw !important;
        max-width: none !important;
    }

}

/* =========================================================
   DESKTOP TARGET TUNING 07 — LOGO HORIZONTAL LOCK
   Compensates for transparent space inside logo PNG.
   Size and vertical position intentionally unchanged.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .mobile-hero-logo {
        left: 67.7% !important;
    }

}

/* =========================================================
   DESKTOP TARGET TUNING 08 — LOGO HORIZONTAL FINAL
   Width + vertical position locked.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .mobile-hero-logo {
        left: 60% !important;
    }

}

/* =========================================================
   DESKTOP TARGET FOUNDATION — 16:9 DESIGN STAGE
   The approved desktop target is composed at 16:9.
   On wider monitors, scale the artwork and live-content stage
   by viewport HEIGHT instead of stretching everything by width.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .hero {
        background-size: auto 100% !important;
        background-position: left center !important;
        background-repeat: no-repeat !important;
        background-color: #f2d9ad !important;
    }

    .hero-copy {
        inset: auto !important;

        top: 0 !important;
        left: 0 !important;

        width: min(100vw, 177.7778vh) !important;
        height: 100vh !important;

        max-width: none !important;

        transform: none !important;
    }

    /* Reset logo onto the approved 16:9 stage.
       All following desktop components will now use this same stage. */

    .mobile-hero-logo {
        top: 4.2% !important;
        left: 60% !important;
        width: 53.7% !important;
        max-width: none !important;
    }

}

/* =========================================================
   DESKTOP TARGET FOUNDATION 02 — CENTRE 16:9 STAGE
   Removes the awkward right-side gap on ultrawide viewports.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    body.portrait-gateway,
    #main {
        background: #f2d9ad !important;
    }

    .hero {
        background-position: center center !important;
    }

    .hero-copy {
        left: 50% !important;
        transform: translateX(-50%) !important;
    }

}

/* =========================================================
   DESKTOP TARGET FOUNDATION 03 — RESTORE FULL-VIEWPORT ART
   Background fills browser again.
   Live content will be tuned independently.
   ========================================================= */

@media (min-width: 901px) and (min-height: 601px) {

    .hero {
        width: 100vw !important;
        height: 100vh !important;

        background-image: url("assets/hero/hero-desktop.png") !important;
        background-size: cover !important;
        background-position: center center !important;
        background-repeat: no-repeat !important;
    }

    .hero-copy {
        top: 0 !important;
        left: 0 !important;

        width: 100vw !important;
        height: 100vh !important;

        transform: none !important;
    }

}
